<?xml version="1.0"?>
<ruleset name="Assinafy">
    <description>PHP 8.3+ application code style.</description>
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <file>appinfo/routes.php</file>
    <file>lib</file>
    <file>tests</file>
    <rule ref="PSR12">
        <exclude name="Generic.WhiteSpace.ScopeIndent"/>
    </rule>
</ruleset>
